set -euo pipefail
mux_errors=0
mux_try() {
"$@" || {
mux_errors=$((mux_errors + 1))
printf 'mux: tmux command failed: %s\n' "$*" >&2
}
}
mux_abort() {
printf 'mux: %s\n' "$*" >&2
exit 1
}
tmux start-server 2>/dev/null || true
cd ~/test
if ! tmux has-session -t =pane_titles 2>/dev/null; then
mux_new_session() {
tmux new-session -d -P -F '#{window_index} #{pane_index}' -s pane_titles -x "${MUX_TMUX_COLUMNS:-120}" -y "${MUX_TMUX_LINES:-40}" -n editor -c ~/test
}
if ! mux_session_info=$(mux_new_session 2>/dev/null) &&
! { sleep 0.2; mux_session_info=$(mux_new_session); }; then
mux_abort 'failed to create tmux session '\''pane_titles'\'''
fi
read -r base_index pane_base_index <<< "$mux_session_info"
case "$base_index" in ''|*[!0-9]*) base_index=0;; esac
case "$pane_base_index" in ''|*[!0-9]*) pane_base_index=0;; esac
mux_try tmux set-window-option -t =pane_titles:$((base_index+0)) pane-border-status bottom
mux_try tmux set-window-option -t =pane_titles:$((base_index+0)) pane-border-format ' #T '
mux_try tmux select-pane -t =pane_titles:$((base_index+0)).$((pane_base_index+0)) -T "Editor"
mux_try tmux send-keys -t =pane_titles:$((base_index+0)).$((pane_base_index+0)) "vim" C-m
mux_try tmux splitw -t =pane_titles:$((base_index+0)) -c ~/test
mux_try tmux select-layout -t =pane_titles:$((base_index+0)) tiled
mux_try tmux select-pane -t =pane_titles:$((base_index+0)).$((pane_base_index+1)) -T "Shell"
mux_try tmux send-keys -t =pane_titles:$((base_index+0)).$((pane_base_index+1)) "bash" C-m
mux_try tmux splitw -t =pane_titles:$((base_index+0)) -c ~/test
mux_try tmux select-layout -t =pane_titles:$((base_index+0)) tiled
mux_try tmux select-pane -t =pane_titles:$((base_index+0)).$((pane_base_index+2)) -T "Logs"
mux_try tmux send-keys -t =pane_titles:$((base_index+0)).$((pane_base_index+2)) "tail -f /var/log/syslog" C-m
mux_try tmux select-layout -t =pane_titles:$((base_index+0)) main-vertical
mux_try tmux select-pane -t =pane_titles:$((base_index+0)).$((pane_base_index+0))
mux_try tmux select-window -t =pane_titles:$((base_index+0))
fi
if [ -z "${TMUX:-}" ]; then
exec tmux -u attach-session -t =pane_titles
else
exec tmux -u switch-client -t =pane_titles
fi
if [ "$mux_errors" -gt 0 ]; then
mux_abort "$mux_errors tmux command(s) failed while building the session"
fi
