set -euo pipefail
mux_errors=0
mux_try() {
"$@" || {
mux_errors=$((mux_errors + 1))
printf 'mux: tmux command failed: %s\n' "$*" >&2
}
}
mux_abort() {
printf 'mux: %s\n' "$*" >&2
exit 1
}
tmux -L foo -f ~/.tmux.mac.conf start-server 2>/dev/null || true
cd ~/test
if ! tmux -L foo -f ~/.tmux.mac.conf has-session -t =sample 2>/dev/null; then
mux_new_session() {
tmux -L foo -f ~/.tmux.mac.conf new-session -d -P -F '#{window_index} #{pane_index}' -s sample -x "${MUX_TMUX_COLUMNS:-120}" -y "${MUX_TMUX_LINES:-40}" -n editor -c ~/test
}
if ! mux_session_info=$(mux_new_session 2>/dev/null) &&
! { sleep 0.2; mux_session_info=$(mux_new_session); }; then
mux_abort 'failed to create tmux session '\''sample'\'''
fi
read -r base_index pane_base_index <<< "$mux_session_info"
case "$base_index" in ''|*[!0-9]*) base_index=0;; esac
case "$pane_base_index" in ''|*[!0-9]*) pane_base_index=0;; esac
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+0)).$((pane_base_index+0)) "echo \"I get run in each pane, before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+0)).$((pane_base_index+0)) "vim" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf splitw -t =sample:$((base_index+0)) -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+0)) tiled
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+0)).$((pane_base_index+1)) "echo \"I get run in each pane, before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf splitw -t =sample:$((base_index+0)) -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+0)) tiled
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+0)).$((pane_base_index+2)) "echo \"I get run in each pane, before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+0)).$((pane_base_index+2)) "top" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+0)) main-vertical
mux_try tmux -L foo -f ~/.tmux.mac.conf select-pane -t =sample:$((base_index+0)).$((pane_base_index+0))
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n shell -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+1)).$((pane_base_index+0)) "git pull" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n guard -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+2)).$((pane_base_index+0)) "echo \"I get run in each pane.\" && echo \"Before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf splitw -t =sample:$((base_index+2)) -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+2)) tiled
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+2)).$((pane_base_index+1)) "echo \"I get run in each pane.\" && echo \"Before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf splitw -t =sample:$((base_index+2)) -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+2)) tiled
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+2)).$((pane_base_index+2)) "echo \"I get run in each pane.\" && echo \"Before each pane command!\"" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf select-layout -t =sample:$((base_index+2)) tiled
mux_try tmux -L foo -f ~/.tmux.mac.conf select-pane -t =sample:$((base_index+2)).$((pane_base_index+0))
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n database -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+3)).$((pane_base_index+0)) "bundle exec rails db" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n server -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+4)).$((pane_base_index+0)) "bundle exec rails s" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n logs -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+5)).$((pane_base_index+0)) "tail -f log/development.log" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n console -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+6)).$((pane_base_index+0)) "bundle exec rails c" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n capistrano -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf new-window -t =sample -n server2 -c ~/test
mux_try tmux -L foo -f ~/.tmux.mac.conf send-keys -t =sample:$((base_index+8)).$((pane_base_index+0)) "ssh user@example.com" C-m
mux_try tmux -L foo -f ~/.tmux.mac.conf select-window -t =sample:$((base_index+0))
fi
if [ -z "${TMUX:-}" ]; then
exec tmux -L foo -f ~/.tmux.mac.conf -u attach-session -t =sample
else
exec tmux -L foo -f ~/.tmux.mac.conf -u switch-client -t =sample
fi
if [ "$mux_errors" -gt 0 ]; then
mux_abort "$mux_errors tmux command(s) failed while building the session"
fi
