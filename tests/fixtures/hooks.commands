set -euo pipefail
mux_errors=0
mux_try() {
"$@" || {
mux_errors=$((mux_errors + 1))
printf 'mux: tmux command failed: %s\n' "$*" >&2
}
}
mux_abort() {
printf 'mux: %s\n' "$*" >&2
exit 1
}
tmux start-server 2>/dev/null || true
cd ~/test
set +euo pipefail
echo "project start"
set -euo pipefail
if ! tmux has-session -t =hooks 2>/dev/null; then
set +euo pipefail
echo "first start"
set -euo pipefail
mux_new_session() {
tmux new-session -d -P -F '#{window_index} #{pane_index}' -s hooks -x "${MUX_TMUX_COLUMNS:-120}" -y "${MUX_TMUX_LINES:-40}" -n main -c ~/test
}
if ! mux_session_info=$(mux_new_session 2>/dev/null) &&
! { sleep 0.2; mux_session_info=$(mux_new_session); }; then
mux_abort 'failed to create tmux session '\''hooks'\'''
fi
read -r base_index pane_base_index <<< "$mux_session_info"
case "$base_index" in ''|*[!0-9]*) base_index=0;; esac
case "$pane_base_index" in ''|*[!0-9]*) pane_base_index=0;; esac
mux_try tmux send-keys -t =hooks:$((base_index+0)).$((pane_base_index+0)) "echo \"main window\"" C-m
mux_try tmux select-window -t =hooks:$((base_index+0))
else
set +euo pipefail
echo "restart"
set -euo pipefail
fi
if [ -z "${TMUX:-}" ]; then
tmux -u attach-session -t =hooks
else
tmux -u switch-client -t =hooks
fi
set +euo pipefail
echo "exit"
set -euo pipefail
if [ "$mux_errors" -gt 0 ]; then
mux_abort "$mux_errors tmux command(s) failed while building the session"
fi
