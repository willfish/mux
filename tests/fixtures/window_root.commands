set -euo pipefail
mux_errors=0
mux_try() {
"$@" || {
mux_errors=$((mux_errors + 1))
printf 'mux: tmux command failed: %s\n' "$*" >&2
}
}
mux_abort() {
printf 'mux: %s\n' "$*" >&2
exit 1
}
tmux start-server 2>/dev/null || true
cd ~/default
if ! tmux has-session -t =window_root 2>/dev/null; then
mux_new_session() {
tmux new-session -d -P -F '#{window_index} #{pane_index}' -s window_root -x "${MUX_TMUX_COLUMNS:-120}" -y "${MUX_TMUX_LINES:-40}" -n home -c ~/
}
if ! mux_session_info=$(mux_new_session 2>/dev/null) &&
! { sleep 0.2; mux_session_info=$(mux_new_session); }; then
mux_abort 'failed to create tmux session '\''window_root'\'''
fi
read -r base_index pane_base_index <<< "$mux_session_info"
case "$base_index" in ''|*[!0-9]*) base_index=0;; esac
case "$pane_base_index" in ''|*[!0-9]*) pane_base_index=0;; esac
mux_try tmux send-keys -t =window_root:$((base_index+0)).$((pane_base_index+0)) "ls" C-m
mux_try tmux new-window -t =window_root -n projects -c ~/projects
mux_try tmux send-keys -t =window_root:$((base_index+1)).$((pane_base_index+0)) "ls" C-m
mux_try tmux new-window -t =window_root -n default_root -c ~/default
mux_try tmux send-keys -t =window_root:$((base_index+2)).$((pane_base_index+0)) "pwd" C-m
mux_try tmux select-window -t =window_root:$((base_index+0))
fi
if [ -z "${TMUX:-}" ]; then
exec tmux -u attach-session -t =window_root
else
exec tmux -u switch-client -t =window_root
fi
if [ "$mux_errors" -gt 0 ]; then
mux_abort "$mux_errors tmux command(s) failed while building the session"
fi
